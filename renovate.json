{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>juliushenke/renovate-preset#v3.1.0"
  ],
  "internalChecksAsSuccess": true,
  "schedule": [
    "at any time"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "IP lookup databases, released monthly in TorMap/ip-lookup-data and downloaded by the backend build",
      "managerFilePatterns": [
        "/^backend/gradle\\.properties$/"
      ],
      "matchStrings": [
        "ipLookupDataVersion=(?<currentValue>\\d{4}-\\d{2})"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "TorMap/ip-lookup-data",
      "versioningTemplate": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})$"
    }
  ],
  "packageRules": [
    {
      "description": "Ignore outdated dependencies required by TorProject descriptor library",
      "matchManagers": [
        "gradle"
      ],
      "enabled": false,
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "/^commons-codec/",
        "/^org.apache.commons/",
        "/^com.fasterxml.jackson.core/",
        "/^org.tukaani/"
      ]
    },
    {
      "description": "Leaflet related updates",
      "groupName": "leaflet",
      "prPriority": 0,
      "matchPackageNames": [
        "/leaflet/"
      ]
    },
    {
      "description": "Require manual review for frontend dependency updates",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/package.json"
      ],
      "automerge": false
    },
    {
      "description": "Group MUI updates",
      "groupName": "mui",
      "matchPackageNames": [
        "/^@mui\\//"
      ]
    },
    {
      "description": "Group React updates",
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "description": "Update the IP lookup databases as soon as a monthly release exists (releases are immutable)",
      "matchDepNames": [
        "TorMap/ip-lookup-data"
      ],
      "minimumReleaseAge": "0 days"
    }
  ]
}
