{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>juliushenke/renovate-preset#v3.1.0"
  ],
  "schedule": [
    "at any time"
  ],
  "packageRules": [
    {
      "description": "Ignore outdated dependencies required by TorProject descriptor library",
      "matchManagers": [
        "gradle"
      ],
      "enabled": false,
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "/^commons-codec/",
        "/^org.apache.commons/",
        "/^com.fasterxml.jackson.core/",
        "/^org.tukaani/"
      ]
    },
    {
      "description": "Leaflet related updates",
      "groupName": "leaflet",
      "prPriority": 0,
      "matchPackageNames": [
        "/leaflet/"
      ]
    },
    {
      "description": "Require manual review for frontend dependency updates",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/package.json"
      ],
      "automerge": false
    },
    {
      "description": "Group MUI updates",
      "groupName": "mui",
      "matchPackageNames": [
        "/^@mui\\//"
      ]
    },
    {
      "description": "Group React updates",
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    }
  ]
}
