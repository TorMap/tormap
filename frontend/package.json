{
  "name": "tormap",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --port 3000",
    "build": "tsc && tsc -p src/service-worker && vite build",
    "preview": "vite preview --port 3000",
    "lint": "eslint ./src --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "snyk:test": "snyk test --severity-threshold=high",
    "smoke:load": "bash ./scripts/smoke-load.sh",
    "smoke:load:ci": "bash ./scripts/smoke-load.sh --skip-build",
    "smoke:pwa": "node ./scripts/smoke-pwa.mjs"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/x-date-pickers": "9.17.0",
    "date-fns": "4.4.0",
    "jotai": "2.20.3",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "playwright": "1.65.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  },
  "resolutions": {
    "tar": "7.5.22"
  },
  "packageManager": "yarn@4.18.1"
}
