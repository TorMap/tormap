# You can create a .env.local file and manipulate values for local testing (e.g. point backend to http://localhost:8080)
VITE_BACKEND_API_URL=https://api.tormap.org
# Public URL of this frontend, for canonical and social media links, robots.txt, sitemap.xml and llms.txt
VITE_SITE_URL=https://tormap.org
# TorMap Lite for browsers without JavaScript: set to false if your backend does not serve /lite/
VITE_LITE_ENABLED=true
