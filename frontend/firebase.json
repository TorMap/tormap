{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "**/.yarn/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://basemaps.cartocdn.com https://avatars.githubusercontent.com; font-src 'self'; connect-src 'self' https://api.tormap.org; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      },
      {
        "source" : "**/*.@(jpg|jpeg|gif|png|svg|ico)",
        "headers" : [ {
          "key" : "Cache-Control",
          "value" : "max-age=604800"
        } ]
      },
      {
        "source" : "**/*.@(css|woff2)",
        "headers" : [ {
          "key" : "Cache-Control",
          "value" : "max-age=31536000, immutable"
        } ]
      },
      {
        "source" : "assets/**",
        "headers" : [ {
          "key" : "Cache-Control",
          "value" : "max-age=31536000, immutable"
        } ]
      },
      {
        "source" : "/",
        "headers" : [ {
          "key" : "Cache-Control",
          "value" : "no-cache"
        } ]
      },
      {
        "source" : "/index.html",
        "headers" : [ {
          "key" : "Cache-Control",
          "value" : "no-cache"
        } ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
