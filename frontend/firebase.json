{
  "hosting": {
    "public": "build",
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/.yarn/**"
    ],
    "headers": [
      {
        "source" : "**/*.@(jpg|jpeg|gif|png|svg|ico)",
        "headers" : [ {
          "key" : "Cache-Control",
          "value" : "max-age=604800"
        } ]
      },
      {
        "source" : "**/*.@(css|woff2)",
        "headers" : [ {
          "key" : "Cache-Control",
          "value" : "max-age=31536000, immutable"
        } ]
      },
      {
        "source" : "assets/**",
        "headers" : [ {
          "key" : "Cache-Control",
          "value" : "max-age=31536000, immutable"
        } ]
      },
      {
        "source" : "/",
        "headers" : [ {
          "key" : "Cache-Control",
          "value" : "no-cache"
        } ]
      },
      {
        "source" : "/index.html",
        "headers" : [ {
          "key" : "Cache-Control",
          "value" : "no-cache"
        } ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
